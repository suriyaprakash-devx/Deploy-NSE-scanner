# Upstox API Credentials
# Provide your Upstox API v2 / v3 access token (can also be entered/updated via the Dashboard UI)
UPSTOX_ACCESS_TOKEN=

# Database URL
# For local development: sqlite:///./data/nse_scanner.db
# For production / Render PostgreSQL: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./data/nse_scanner.db

# Strategy & Scanner Configuration
# Timeframe: 5M or 10M
DEFAULT_TIMEFRAME=5M

# Universe: ALL_NSE (all 2600+ equities), NIFTY500, NIFTY100, NIFTY50
SCAN_UNIVERSE=ALL_NSE

# Scan cycle interval in seconds (default: 30)
SCAN_INTERVAL_SECONDS=30

# Rate Limiter & Concurrency Settings
MAX_REQUESTS_PER_SECOND=20
MAX_CONCURRENT_REQUESTS=12

# Optional Alerts (Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server Port
PORT=8000
HOST=0.0.0.0
