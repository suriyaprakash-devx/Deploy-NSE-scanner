# ==============================================================================
# UPSTOX SEMI-ALGO SCANNER ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. UPSTOX ACCESS TOKEN (Direct Token Entry)
# Paste your daily Upstox Access Token here (valid for 24 hours / expires 3:30 AM IST)
UPSTOX_ACCESS_TOKEN=

# 2. UPSTOX OAUTH 2.0 (Optional - only if using OAuth redirect flow)
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/auth/callback

# 3. DATABASE CONFIGURATION
# Leave empty for local SQLite (data/nse_scanner.db) or provide PostgreSQL connection string for Render
DATABASE_URL=
DELETE_RESULTS_AFTER_SCAN=false

# 4. SECURITY & URLS
SECRET_KEY=change_this_to_a_secure_random_string_32_chars_or_more
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
